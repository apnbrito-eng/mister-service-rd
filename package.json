{
  "name": "mister-service-rd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.api.json && vite build",
    "lint": "eslint . --report-unused-disable-directives",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "preview": "vite preview",
    "deploy:rules": "npx firebase deploy --only firestore:rules && tsx scripts/invariantes/marcar-rules-deployadas.ts",
    "deploy:storage-rules": "npx firebase deploy --only storage && tsx scripts/invariantes/marcar-storage-rules-deployadas.ts",
    "deploy:indexes": "npx firebase deploy --only firestore:indexes",
    "check:regression": "tsx scripts/invariantes/run-all.ts",
    "check:regression:ci": "tsx scripts/invariantes/run-all.ts --ci",
    "audit:notis-legacy": "tsx scripts/invariantes/check-notis-legacy-data-shape.ts",
    "audit:schema-drift": "tsx scripts/auditoria/schema-drift.ts",
    "metricas": "tsx scripts/metricas-mejora-continua.ts",
    "mapa": "node scripts/generar_mapa.js && node scripts/generar_svg.js",
    "prepare": "husky",
    "test:integraciones": "vitest run --config vitest.integraciones.config.ts",
    "test:rules": "npx firebase emulators:exec --only firestore --project demo-mister-service-rules \"vitest run --config vitest.rules.config.ts\"",
    "mobile:build": "tsc && tsc -p tsconfig.api.json && vite build --mode mobile --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:preflight": "node scripts/mobile/preflight.mjs",
    "capacitor:sync:after": "node scripts/mobile/prepare-ios-spm.mjs",
    "capacitor:update:after": "node scripts/mobile/prepare-ios-spm.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@capacitor-community/background-geolocation": "1.2.26",
    "@capacitor-firebase/app-check": "7.5.0",
    "@capacitor-firebase/messaging": "7.5.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/camera": "7.0.5",
    "@capacitor/core": "7.6.9",
    "@capacitor/geolocation": "7.1.8",
    "@capacitor/ios": "7.6.9",
    "@capacitor/local-notifications": "7.0.7",
    "@types/leaflet": "^1.9.8",
    "@types/leaflet.heat": "^0.2.5",
    "@types/leaflet.markercluster": "^1.5.6",
    "date-fns": "^2.30.0",
    "exceljs": "^4.4.0",
    "firebase": "11.10.0",
    "firebase-admin": "^12.7.0",
    "js-yaml": "^4.1.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.294.0",
    "motion": "13.4.4",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vercel/node": "^5.7.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "csv-parse": "^5.6.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "husky": "^9.1.7",
    "postcss": "^8.4.31",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^5.0.0",
    "vitest": "3.2.7"
  }
}
