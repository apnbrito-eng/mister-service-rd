# Copiar a .env.mobile.local y completar con recursos separados de producción.
# No usar la vista de pruebas conectada a clientes reales.
VITE_MOBILE_STAGE=staging
VITE_MOBILE_API_ORIGIN=https://BACKEND-DE-PRUEBAS
MOBILE_STAGING_FIREBASE_PROJECT_ID=PROYECTO-DE-PRUEBAS
VITE_FIREBASE_PROJECT_ID=PROYECTO-DE-PRUEBAS
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check nativo utiliza App Attest/DeviceCheck o Play Integrity.
# No incorporar claves de servidor ni credenciales de firma en VITE_*.

# Solo ensayo aislado: cada dispositivo genera un token de depuración que se registra en Firebase.
VITE_MOBILE_APPCHECK_DEBUG=false
