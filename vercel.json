{
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/eliminacion-datos",
      "destination": "/eliminacion-datos.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/movil/avisos",
      "schedule": "* * * * *"
    }
  ]
}
